---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign empty_array = "" | split: "" %}
  {% assign blog_en_docs = site.blog_en | default: empty_array %}
  {% assign blog_fr_docs = site.blog_fr | default: empty_array %}
  {% assign sitemap_pages = site.pages | concat: blog_en_docs | concat: blog_fr_docs | sort: "url" %}
  {% for item in sitemap_pages %}
    {% unless item.sitemap == false or item.url == '/404.html' %}
      <url>
        <loc>{{ item.url | absolute_url }}</loc>
        {% if item.date %}
          <lastmod>{{ item.date | date_to_xmlschema }}</lastmod>
        {% endif %}
      </url>
    {% endunless %}
  {% endfor %}
</urlset>
