---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign sitemap_pages = site.pages | concat: site.blog_en.docs | concat: site.blog_fr.docs | sort: "url" %}
  {% for item in sitemap_pages %}
    {% unless item.sitemap == false or item.url == '/404.html' %}
      <url>
        <loc>{{ item.url | absolute_url }}</loc>
        {% if item.date %}
          <lastmod>{{ item.date | date_to_xmlschema }}</lastmod>
        {% endif %}
      </url>
    {% endunless %}
  {% endfor %}
</urlset>
